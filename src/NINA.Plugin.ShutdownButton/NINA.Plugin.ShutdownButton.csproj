<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NINA.Plugin.ShutdownButton</AssemblyName>
    <RootNamespace>NINA.Plugin.ShutdownButton</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>grm</Authors>
    <Description>Manually stop a N.I.N.A. sequence and safely shut down equipment.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute"><_Parameter1>87a0ca7c-d8e6-4f47-b718-c70270f86adb</_Parameter1></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MinimumApplicationVersion" Value="3.2.0.9001" />
    <AssemblyMetadata Include="Repository" Value="https://github.com/grm/nina.plugin.shutdown-button" />
    <AssemblyMetadata Include="Homepage" Value="https://github.com/grm/nina.plugin.shutdown-button" />
    <AssemblyMetadata Include="License" Value="MIT" />
    <AssemblyMetadata Include="Tags" Value="shutdown,safety,sequencer" />
  </ItemGroup>
</Project>